# Server-only secrets. Never commit .env.local.
BANKR_API_KEY=
DEFINITIVE_API_KEY=
UNISWAP_API_KEY=
# Required in production: random secret used to sign Flitzr sessions.
AUTH_SECRET=replace-with-a-long-random-secret
# Required for persistent execution/audit storage in Vercel.
POSTGRES_URL=
# x402 v2 seller configuration. payTo is a public receiving address; facilitator URL stays server-side.
X402_PAY_TO=
X402_PRICE_USDC=0.01
X402_FACILITATOR_URL=
# Optional: public app URL for callbacks/metadata when needed.
NEXT_PUBLIC_APP_URL=http://localhost:3000
