# Server-only secrets. Never commit .env.local.
BANKR_API_KEY=
DEFINITIVE_API_KEY=
# Required in production: random secret used to sign Flitzr sessions.
AUTH_SECRET=replace-with-a-long-random-secret
# Required for persistent execution/audit storage in Vercel.
POSTGRES_URL=
# x402 receiver and price. Keep secrets server-side; payTo is a public receiving address.
X402_PAY_TO=
X402_PRICE_USDC=0.01
# Optional: public app URL for callbacks/metadata when needed.
NEXT_PUBLIC_APP_URL=http://localhost:3000
